APP_NAME=ExpenseTrackerAPI
ENVIRONMENT=development

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=expensedb
MONGODB_MIN_POOL_SIZE=1
MONGODB_MAX_POOL_SIZE=20

REFRESH_TOKEN_EXPIRE_DAYS=30

# LangChain/LangGraph agent layer (app/agents, app/tools). Leave ANTHROPIC_API_KEY
# blank to use the placeholder chat responder instead — no key is required to run
# the app or the test suite.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
